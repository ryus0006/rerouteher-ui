# `npm run dev` uses mocks (src/mocks); `npm run dev:live` sets VITE_USE_MOCKS=0 and
# talks to the real API below. Override VITE_API_BASE_URL in .env.local if your local
# backend is on a different port (local-start picks 8080, or 8081 if 8080 is busy).
VITE_USE_MOCKS=1
VITE_API_BASE_URL=http://localhost:8081
